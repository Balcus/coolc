{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Rust",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/coolc",
            "args": [
                "${input:programArgs}"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cargo build",
        },
        {
            "name": "Debug atoi test",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--test",
                    "type_checking"
                ],
                "filter": {
                    "name": "type_checking"
                }
            },
            "args": [
                "atoi"
            ],
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "programArgs",
            "type": "promptString",
            "description": "Arguments to pass to coolc",
        }
    ]
}