/*
 * Parser Output:
 * Semantic actions should build an parse_tree
 * The root of the parse_tree (and only the root) should be of type program
 * For programs that have errors, the output is the error message
 * For multi line constructs free to use any line that is part of the construct
 * Parser needs to work for programs contained in a single file
 *
 * Error Handling:
 * The parser should recover in the following situations:
 * - if error in class definition but class terminated properly and next class is syntactically correct,
 * the parser should be able to start from next class definition
 *
 * - similarly, parser should recover from errors in features (going on to the next feature),
 * a let binding (going on to the next variable), and an expression inside a { ... } block
 *
 *
 * Remarks:
 * - Only use precedence declarations for expressions
 * - the let construct introduces ambiguity,
 * the manual says let expression extends as far to the right as possible
 */

use crate::lexer::{Token, ErrorToken};
use lalrpop_util::ErrorRecovery;
use crate::parse_tree;
use crate::utils::{Span, ReturnType};

grammar<'err>(file: &'err str, errors: &'err mut Vec<ErrorRecovery<usize, Token, ErrorToken>>);

extern {
    type Location = usize;
    type Error = ErrorToken;
    enum Token {
        "+" => Token::Plus,
        "-" => Token::Minus,
        "*" => Token::Star,
        "@" => Token::At,
        "." => Token::Dot,
        "~" => Token::Tilde,
        "/" => Token::Slash,
        "=>" => Token::FatArrow,
        "<" => Token::Lt,
        "<=" => Token::Le,
        ">" => Token::Gt,
        ">=" => Token::Ge,
        ";" => Token::Semicolon,
        "," => Token::Comma,
        ":" => Token::Colon,
        "{" => Token::LBrace,
        "}" => Token::RBrace,
        "(" => Token::LParen,
        ")" => Token::RParen,
        "=" => Token::Eq,
        "<-" => Token::Assign,
        "self" => Token::SelfValue,
        "SELF_TYPE" => Token::SelfType,
        "class" => Token::Class,
        "else" => Token::Else,
        "fi" => Token::Fi,
        "if" => Token::If,
        "in" => Token::In,
        "inherits" => Token::Inherits,
        "isvoid" => Token::IsVoid,
        "let" => Token::Let,
        "loop" => Token::Loop,
        "pool" => Token::Pool,
        "then" => Token::Then,
        "while" => Token::While,
        "case" => Token::Case,
        "esac" => Token::Esac,
        "new" => Token::New,
        "of" => Token::Of,
        "not" => Token::Not,
        "boolean" => Token::BoolConst(<bool>),
        "integer" => Token::Integers(<i64>),
        "string" => Token::StringConstant(<usize>),
        "TYPE" => Token::TypeIdentifier(<usize>),
        "ID" => Token::ObjectIdentifier(<usize>),
    }
}

// Macro for comma separated lists (args in method definition)
Comma<T>: Vec<T> = {
    <first: T> <rest: ("," <T>)*> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
    => vec![],
};

// Helper type for a single binding (x: Type or x: Type <- y)
Binding: (parse_tree::Id, ReturnType, Option<Box<parse_tree::Expr>>, Span) = {
    <l:@L> <n: "ID"> ":" <t: Type> <r:@R> =>
        (n, t, None, Span::new(file.to_string(), l, r)),
    <l:@L> <n: "ID"> ":" <t: Type> "<-" <e: FullExpr> <r:@R> =>
        (n, t, Some(Box::new(e)), Span::new(file.to_string(), l, r)),
}

FullExpr: parse_tree::Expr = {
    <e: Expr> => e,
}

pub Program: parse_tree::Program = {
    <classes: (<Class> ";")+> => parse_tree::Program { classes }
}

Class: parse_tree::Class = {
    "class" <name: "TYPE"> "{" <features: Feature*> "}" =>
        parse_tree::Class::Valid {
            name,
            parent: None,
            features,
        },

    "class" <name: "TYPE"> "inherits" <parent: "TYPE"> "{" <features: Feature*> "}" =>
        parse_tree::Class::Valid {
            name,
            parent: Some(parent),
            features
        },

    "class" <e: !> "}" => {
        errors.push(<>);
        parse_tree::Class::Invalid
    },
}

Feature: parse_tree::Feature = {
    // Attribute
    <name: "ID"> ":" <type_dec: Type> ";" =>
        parse_tree::Feature::Attribute {
            name,
            type_dec,
            init: None
        },

    <name: "ID"> ":" <type_dec: Type> "<-" <expr: FullExpr> ";" =>
        parse_tree::Feature::Attribute {
            name,
            type_dec,
            init: Some(Box::new(expr))
        },

    // Method
    <name: "ID"> "(" <params: Comma<Formal>> ")" ":" <type_dec: Type> "{" <expr: FullExpr> "}" ";" =>
        parse_tree::Feature::Method {
            name,
            params,
            type_dec,
            body: Box::new(expr),
        },

    // Method with block body
    <name: "ID"> "(" <params: Comma<Formal>> ")" ":" <type_dec: Type>
    "{" <body: (<FullExpr> ";")+> "}" ";" =>
        parse_tree::Feature::Method {
            name,
            params,
            type_dec,
            body: Box::new(
                parse_tree::Expr::new(
                    parse_tree::ExprKind::Block(body),
                    file,
                    0,
                    0,
                )
            ),
        },

    // Invalid features
    <e: !> ";" => {
        errors.push(<>);
        parse_tree::Feature::Invalid
    }
}

Formal: parse_tree::Formal = {
    <name: "ID"> ":" <type_dec: "TYPE"> =>
        parse_tree::Formal {
            name,
            type_dec
        },
}

Branch: parse_tree::CaseBranch = {
    <name: "ID"> ":" <type_dec: "TYPE"> "=>" <expr: FullExpr> =>
        parse_tree::CaseBranch {
            name,
            type_dec,
            body: Box::new(expr)
        },
}

Paren: parse_tree::Expr = {
    "(" <e: FullExpr> ")" => e,
}

Type: ReturnType = {
    <t: "TYPE"> => ReturnType::Type(t),
    "SELF_TYPE" => ReturnType::SelfType,
}

Expr: parse_tree::Expr = {
    // Constants & Identifiers
    #[precedence(level="0")]
    <l:@L> <n: "integer"> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::IntConstant(n), file, l, r),
    <l:@L> <s: "string"> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::StringConstant(s), file, l, r),
    <l:@L> <b: "boolean"> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::BoolConstant(b), file, l, r),
    <l:@L> <o: "ID"> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Object(o), file, l, r),
    <l:@L> "self" <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::SelfExpr, file, l, r),
    <e: Paren> => e,

    // Control flow
    <l:@L> "if" <cond: FullExpr> "then" <happy_path: FullExpr> "else" <sad_path: FullExpr> "fi" <r:@R> =>
        parse_tree::Expr::new(
            parse_tree::ExprKind::Conditional {
                cond: Box::new(cond),
                happy_path: Box::new(happy_path),
                sad_path: Box::new(sad_path),
            },
            file, l, r,
        ),

    <l:@L> "while" <cond: FullExpr> "loop" <body: FullExpr> "pool" <r:@R> =>
        parse_tree::Expr::new(
            parse_tree::ExprKind::Loop { cond: Box::new(cond), body: Box::new(body) },
            file, l, r,
        ),

    <l:@L> "{" <body: (<FullExpr> ";")+> "}" <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Block(body), file, l, r),

    <l:@L> "case" <cond: FullExpr> "of" <branches: (<Branch> ";")+> "esac" <r:@R> =>
        parse_tree::Expr::new(
            parse_tree::ExprKind::Case { cond: Box::new(cond), branches },
            file, l, r,
        ),

    <l:@L> "new" <type_dec: Type> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::New(type_dec), file, l, r),

    // Dispatch
    #[precedence(level="1")] #[assoc(side="left")]
    <l:@L> <expr: Expr> "." <name: "ID"> "(" <args: Comma<FullExpr>> ")" <r:@R> =>
        parse_tree::Expr::new(
            parse_tree::ExprKind::Dispatch { expr: Box::new(expr), name, args },
            file, l, r,
        ),

    <l:@L> <name: "ID"> "(" <args: Comma<FullExpr>> ")" <r:@R> =>
        parse_tree::Expr::new(
            parse_tree::ExprKind::SelfDispatch { name, args },
            file, l, r,
        ),

    <l:@L> <expr: Expr> "@" <type_dec: "TYPE"> "." <name: "ID"> "(" <args: Comma<FullExpr>> ")" <r:@R> =>
        parse_tree::Expr::new(
            parse_tree::ExprKind::StaticDispatch { expr: Box::new(expr), type_dec, name, args },
            file, l, r,
        ),

    // isvoid & negation
    #[precedence(level="2")]
    <l:@L> "~" <e: Expr> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Neg(Box::new(e)), file, l, r),
    <l:@L> "isvoid" <e: Expr> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::IsVoid(Box::new(e)), file, l, r),

    // Arithmetic
    #[precedence(level="3")] #[assoc(side="left")]
    <l:@L> <e1: Expr> "*" <e2: Expr> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Mul(Box::new(e1), Box::new(e2)), file, l, r),
    <l:@L> <e1: Expr> "/" <e2: Expr> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Div(Box::new(e1), Box::new(e2)), file, l, r),

    #[precedence(level="4")] #[assoc(side="left")]
    <l:@L> <e1: Expr> "+" <e2: Expr> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Add(Box::new(e1), Box::new(e2)), file, l, r),
    <l:@L> <e1: Expr> "-" <e2: Expr> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Sub(Box::new(e1), Box::new(e2)), file, l, r),

    // Comparison
    #[precedence(level="5")] #[assoc(side="none")]
    <l:@L> <e1: Expr> ">" <e2: Expr> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Lt(Box::new(e2), Box::new(e1)), file, l, r),
    <l:@L> <e1: Expr> ">=" <e2: Expr> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Le(Box::new(e2), Box::new(e1)), file, l, r),
    <l:@L> <e1: Expr> "<" <e2: Expr> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Lt(Box::new(e1), Box::new(e2)), file, l, r),
    <l:@L> <e1: Expr> "<=" <e2: Expr> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Le(Box::new(e1), Box::new(e2)), file, l, r),
    <l:@L> <e1: Expr> "=" <e2: Expr> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Eq(Box::new(e1), Box::new(e2)), file, l, r),

    // Not
    #[precedence(level="6")]
    <l:@L> "not" <e: Expr> <r:@R> =>
        parse_tree::Expr::new(parse_tree::ExprKind::Not(Box::new(e)), file, l, r),

    // Assignment
    #[precedence(level="7")] #[assoc(side="right")]
    <l:@L> <var: "ID"> "<-" <expr: FullExpr> <r:@R> =>
        parse_tree::Expr::new(
            parse_tree::ExprKind::Assignment { var: parse_tree::Var::Id(var), expr: Box::new(expr) },
            file, l, r,
        ),
    <l:@L> "self" "<-" <expr: FullExpr> <r:@R> =>
        parse_tree::Expr::new(
            parse_tree::ExprKind::Assignment { var: parse_tree::Var::SelfValue, expr: Box::new(expr) },
            file, l, r,
        ),

    // Let
    #[precedence(level="8")]
    <l:@L> "let" <first: Binding> <rest: ("," <Binding>)*> "in" <body: FullExpr> <r:@R> => {
        let mut bindings = vec![first];
        bindings.extend(rest);

        let mut result = bindings.into_iter().rev().fold(body, |inner_body, (name, type_dec, init, span)| {
            parse_tree::Expr {
                kind: parse_tree::ExprKind::Let {
                    name,
                    type_dec,
                    init,
                    body: Box::new(inner_body),
                },
                span,
            }
        });
        result.span = Span::new(file.to_string(), l, r);
        result
    },

    <e: !> ";" => {
        errors.push(<>);
        parse_tree::Expr::new(parse_tree::ExprKind::Invalid, file, 0, 0)
    },
}
